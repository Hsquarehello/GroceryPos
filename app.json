{
  "expo": {
    "name": "GroceryPOS",
    "slug": "GroceryPOS",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7D1",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFF7D1"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#FFF7D1",
      "icon": "./assets/icon.png"
    },
    "android": {
      "backgroundColor": "#FFF7D1",
      "icon": "./assets/icon.png",
      "versionCode": 8,
      "adaptiveIcon": {
        "backgroundColor": "#FFF7D1",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "package": "com.heinhtet_18.GroceryPOS"
    },
    // "web": {
    //   "favicon": "./assets/icon.png"
    // },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GroceryPOS to scan product barcodes",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7D1",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e585018c-5dbb-4903-8077-19c2d8796fe8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e585018c-5dbb-4903-8077-19c2d8796fe8",
      "checkAutomatically": "NEVER"
    }
  }
}
